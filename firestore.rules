rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cualquiera que conozca el código de familia (households/{id}) puede leer y
    // escribir sus propios datos. No hay contraseña real detrás de esto — es
    // "seguridad por oscuridad": alcanza para una app familiar privada, pero el
    // código de familia no debe compartirse públicamente ni subirse a un repo público.
    match /households/{householdId}/data/{document} {
      allow read, write: if true;
    }
  }
}
